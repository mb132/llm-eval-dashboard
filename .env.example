# Optional local Ollama overrides
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b

# Encryption key for provider credentials stored in SQLite. Generate with:
# python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
LLM_EVAL_MASTER_KEY=

# Alembic creates the SQLite schema. Docker Compose overrides the file location.
DATABASE_URL=sqlite+aiosqlite:///./llm_eval.db
